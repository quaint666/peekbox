{
  "name": "peekbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Peekbox front end: plain HTML, CSS and TypeScript. No framework.",
  "scripts": {
    "build": "tsc && node scripts/copy-data.mjs",
    "watch": "node scripts/copy-data.mjs && tsc --watch",
    "dev": "node scripts/dev-server.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
