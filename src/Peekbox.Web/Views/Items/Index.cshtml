@using Peekbox.Web.Formatting
@using Peekbox.Web.Services
@model ItemViewModel
@{
    var item = Model.Item;
    ViewData["Title"] = item.Name;
    ViewData["Nav"] = SiteLinks.Builder.Key;
    ViewData["Description"] = item.Description;
    var categoryLink = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(SiteLinks.Builder.Href, "category", item.CategoryId) + Anchors.Link(Anchors.Items);
    ViewData[Crumbs.ViewDataKey] = Crumbs.Trail(Crumbs.To(SiteLinks.Builder), Crumbs.To(item.CategoryName, categoryLink), Crumbs.Here(item.Name));
    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var shareUrl = origin + SiteLinks.Item(item.Slug);
    var facebook = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("https://www.facebook.com/sharer/sharer.php", "u", shareUrl);
}

@section Head {
    <meta property="og:type" content="website">
    <meta property="og:title" content="@item.Name · Peekbox">
    <meta property="og:description" content="@item.Description">
    <meta property="og:image" content="@(origin + item.ImagePath)">
    <meta property="og:url" content="@shareUrl">
}

@section Scripts {
    <script type="module" src="~/js/share.js" asp-append-version="true"></script>
    <script type="module" src="~/js/recent.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/builder.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/item.css" asp-append-version="true">
}

@* The item page (F26 to F28, mockup 03 as redrawn 2026-11-16). *@
<div class="item-page">
    <div class="item-main">
        <img class="item-photo" src="@item.ImagePath" alt="@item.Name" width="508" height="508">

        <div class="item-info">
            <div class="item-info__head">
                <a class="item-chip" href="@categoryLink">@item.CategoryName</a>
                <h1 class="item-title">@item.Name</h1>
                <p class="item-brand">@item.Brand</p>
            </div>
            <p class="item-price"><span class="item-price__value">@Vnd.Format(item.PriceVnd)</span><span class="item-price__tax">Đã gồm thuế</span></p>
            <ul class="item-facts">
                <li><partial name="_Icon" model='"calendar"' />@VnDate.Expiry(item.ExpiryDate)</li>
                <li><partial name="_Icon" model='"pin"' />@item.Origin</li>
                <li><partial name="_Icon" model='"weight"' />@item.WeightGrams g</li>
            </ul>
            @if (item.SoldOut)
            {
                <p class="item-note item-note--muted"><partial name="_Icon" model='"warning"' /><span><strong>Hết hàng.</strong> Món này tạm thời không đặt được.</span></p>
            }
            @if (item.ExpiryDate is null)
            {
                <p class="item-note item-note--muted"><partial name="_Icon" model='"calendar"' /><span>Món này không phải đồ ăn nên không có hạn dùng và không cần kiểm tra theo ngày giao.</span></p>
            }
            else if (Model.InDate is null)
            {
                <p class="item-note item-note--muted"><partial name="_Icon" model='"calendar"' /><span>Chọn ngày giao để kiểm tra hạn dùng của món này.</span></p>
            }
            else if (Model.InDate == true)
            {
                <p class="item-note"><partial name="_Icon" model='"check-circle"' /><span><strong>Đủ hạn cho ngày giao @VnDate.Day(Model.DeliveryDate!.Value).</strong> Hạn sử dụng @VnDate.Day(item.ExpiryDate.Value) còn xa hơn ngày giao cộng @BuilderLimits.ShelfMarginDays ngày dự phòng.</span></p>
            }
            else
            {
                <p class="item-note item-note--warn"><partial name="_Icon" model='"warning"' /><span><strong>Không đủ hạn cho ngày giao @VnDate.Day(Model.DeliveryDate!.Value).</strong> Hạn sử dụng @VnDate.Day(item.ExpiryDate.Value) không còn xa hơn ngày giao cộng @BuilderLimits.ShelfMarginDays ngày dự phòng.</span></p>
            }

            <div class="card item-buy" id="@Anchors.ItemBuy">
                <partial name="_ItemBuy" model="Model" />
            </div>

            @* F31: a plain link to Facebook; the two buttons appear when share.ts runs (hidden until then). *@
            <div class="item-share" data-share-url="@shareUrl" data-share-title="@item.Name · Peekbox" role="group" aria-label="Chia sẻ món này">
                <span class="item-share__label">Chia sẻ</span>
                <button type="button" class="item-share__btn" data-share-copy hidden><partial name="_Icon" model='"link"' />Sao chép liên kết</button>
                <a class="item-share__btn" href="@facebook" target="_blank" rel="noopener noreferrer"><partial name="_Icon" model='"external"' />Facebook<span class="visually-hidden"> (mở trang mới)</span></a>
                <button type="button" class="item-share__btn" data-share-system hidden><partial name="_Icon" model='"share"' />Chia sẻ…</button>
            </div>

            <ul class="item-promises">
                <li><partial name="_Icon" model='"shield"' /><span><strong>Hạn dùng được kiểm tra</strong> So với ngày giao bạn chọn</span></li>
                <li><partial name="_Icon" model='"truck"' /><span><strong>Giao theo ngày bạn chọn</strong> Giao tận nơi</span></li>
                <li><partial name="_Icon" model='"card"' /><span><strong>Thanh toán linh hoạt</strong> ZaloPay hoặc tiền mặt</span></li>
            </ul>
        </div>
    </div>

    <section class="card item-about" aria-labelledby="mo-ta">
        <h2 class="item-about__title" id="mo-ta">Mô tả</h2>
        <p class="item-about__text">@item.Description</p>
        <h3 class="item-about__sub">Thông tin chi tiết</h3>
        <dl class="item-details">
            <div><dt>Danh mục</dt><dd>@item.CategoryName</dd></div>
            <div><dt>Thương hiệu</dt><dd>@item.Brand</dd></div>
            <div><dt>Trọng lượng</dt><dd>@item.WeightGrams g</dd></div>
            <div><dt>Xuất xứ</dt><dd>@item.Origin</dd></div>
            <div><dt>Hạn sử dụng</dt><dd>@(item.ExpiryDate is { } expiry ? VnDate.Day(expiry) : VnDate.NoExpiry)</dd></div>
        </dl>
        @{ var detail = ItemDetails.For(item.CategoryId); }
        @* F29: placeholders (Services/ItemDetails.cs): one text for the group of items, and the page says so. *@
        <h3 class="item-about__sub">Thành phần và bảo quản</h3>
        <dl class="item-details" id="thanh-phan">
            @if (detail.Ingredients is { } ingredients)
            {
                <div><dt>Thành phần</dt><dd>@ingredients</dd></div>
            }
            <div><dt>Chất gây dị ứng</dt><dd>@detail.Allergens</dd></div>
            <div><dt>Bảo quản</dt><dd>@detail.Storage</dd></div>
            <div><dt>Cập nhật lần cuối</dt><dd>@VnDate.Day(ItemDetails.ReviewedOn)</dd></div>
        </dl>
        <p class="item-about__note meta">Thông tin mẫu theo nhóm món, chưa phải thông tin riêng của sản phẩm này. Xem bao bì khi nhận hàng.</p>
    </section>

    @* F32: filled by recent.ts from this browser's own list; hidden until it has something to show (no script: stays hidden). *@
    <section class="card recent" aria-labelledby="da-xem" data-recent data-slug="@item.Slug" data-name="@item.Name" data-image="@item.ImagePath" data-href-prefix="@(SiteLinks.ItemsPath + "/")" hidden>
        <h2 class="recent__title" id="da-xem">Đã xem gần đây</h2>
        <ul class="recent__list" data-recent-list></ul>
    </section>

    @* Phone: the same budget and add control in a bar at the bottom of the screen (mockup 03, phone). *@
    <div class="item-bar" data-bottom-bar role="region" aria-label="Thêm vào hộp">
        <partial name="_ItemBuy" model="Model" />
    </div>
</div>
