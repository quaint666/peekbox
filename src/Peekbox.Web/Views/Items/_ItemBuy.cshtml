@using Peekbox.Web.Formatting
@model ItemViewModel
@* The budget and the add control of the item page (F28, mockup 03). Drawn twice by Index.cshtml: in the card next to the
   photo, and in the bar at the bottom of a phone screen; CSS shows one of them. Every number comes from the server. *@
@if (Model.Box is { } box)
{
    var item = Model.Item;
    var quantity = box.QuantityOf(item.Slug);
    // from=item: BuilderController.Quantity sends the visitor back to this page instead of the list.
    var control = new QuantityControl(SiteLinks.QuantityPath + "?from=item", item.Slug, item.Name, quantity,
        box.StatusOf(item.Priced), box.OverByVnd(item.PriceVnd), item.SoldOut, "Thêm vào hộp");
    <dl class="box-sums item-buy__sums">
        <div class="box-sums__row"><dt>Ngân sách</dt><dd>@Vnd.Format(box.BudgetVnd)</dd></div>
        <div class="box-sums__bar"><meter class="budget-meter" min="0" max="@Math.Max(box.BudgetVnd, 1)" value="@box.Quote.GoodsVnd" aria-hidden="true"></meter></div>
        @if (box.Quote.OverBudget)
        {
            <div class="box-sums__row box-sums__row--over"><dt>Vượt ngân sách</dt><dd>@Vnd.Format(box.LeftOrOverVnd)</dd></div>
        }
        else
        {
            <div class="box-sums__row box-sums__row--left"><dt>Còn lại</dt><dd>@Vnd.Format(box.LeftOrOverVnd)</dd></div>
        }
    </dl>
    <div class="item-buy__foot">
        <partial name="_QuantityControl" model="control" />
        @if (quantity > 0)
        {
            <p class="item-buy__in"><span>Đã có trong hộp</span> <strong>@Vnd.Format(box.Lines.First(l => l.Slug == item.Slug).LineVnd)</strong></p>
        }
    </div>
}
else
{
    @* No budget and date saved yet, or the saved date has passed: the items are locked, as on /builder. *@
    <p class="item-buy__locked">Lưu ngân sách và ngày giao để thêm món.</p>
    <a class="btn btn--primary item-buy__go" href="@SiteLinks.Builder.Href">Đặt ngân sách và ngày giao</a>
}
