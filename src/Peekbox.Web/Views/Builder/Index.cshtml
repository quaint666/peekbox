@using Peekbox.Web.Formatting
@using Peekbox.Web.Services
@model BuilderViewModel
@{
    ViewData["Title"] = "Tạo hộp quà";
    ViewData["Nav"] = SiteLinks.Builder.Key;
    var items = Model.Items;
    // Step 2 (items) once the budget and the date are saved, step 3 (packaging) once the box holds an item.
    var currentStep = items is null ? 0 : Model.Box!.Lines.Count == 0 ? 1 : 2;

    // The warning texts. The controller only says which problem it found; the words are here, once.
    var budgetError = Model.BudgetProblem switch
    {
        BudgetProblem.Invalid => "Nhập ngân sách bằng số, ví dụ 500.000đ.",
        _ => null,
    };
    var dateError = Model.DateProblem switch
    {
        DateProblem.Invalid => "Ngày giao hàng không hợp lệ.",
        DateProblem.TooEarly => "Ngày giao hàng sớm nhất là ngày mai.",
        DateProblem.TooLate => "Ngày giao hàng muộn nhất là sau 1 năm kể từ hôm nay.",
        _ => null,
    };

    // The amber note after a pick (state 36): the budget in use stays the saved one until "Lưu". Written here once; the
    // tiles carry it for builder.ts, which only copies it (the browser never writes an amount).
    string UnsavedNote(long picked) => Model.SavedBudgetVnd is { } saved
        ? $"Chưa lưu: ngân sách đang dùng vẫn là {Vnd.Format(saved)}. Bấm Lưu để dùng {Vnd.Format(picked)}."
        : $"Chưa lưu: bấm Lưu để dùng {Vnd.Format(picked)}.";

    // The occasion of "Hộp gợi ý" when the visitor chose one; the first is the default and stays out of the address.
    string? ChosenOccasion() => Model.Suggestions is { } sg && sg.Chosen.Id != sg.Occasions[0].Id ? sg.Chosen.Id : null;

    // A link to this page with the list's filters as they are now, some of them changed (null drops one).
    string ListLink(Dictionary<string, string?> changes, string anchor)
    {
        var items = Model.Items;
        var query = new Dictionary<string, string?>
        {
            ["category"] = items?.Category, ["q"] = items?.Search, ["sort"] = items is null ? null : ItemSorts.ToQuery(items.Sort),
            ["inDate"] = items is { OnlyInDate: false } ? "false" : null, ["fit"] = items is { FitBudget: true } ? "true" : null, ["dip"] = ChosenOccasion(),
        };
        foreach (var (key, value) in changes)
        {
            query[key] = value;
        }

        if (Model.Suggestions is { } sg && query["dip"] == sg.Occasions[0].Id)
        {
            query["dip"] = null;   // the default occasion
        }

        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(SiteLinks.Builder.Href, query.Where(p => !string.IsNullOrEmpty(p.Value))) + Anchors.Link(anchor);
    }
}

@section Banner {
    @await Component.InvokeAsync("SeasonBanner")
}

@section Styles {
    <link rel="stylesheet" href="~/css/builder.css" asp-append-version="true">
}

@section Scripts {
    <script type="module" src="~/js/builder.js" asp-append-version="true"></script>
}

<div class="builder">
    <div class="builder__head">
        <h1 class="builder__title">Tạo hộp quà của bạn</h1>
    </div>
    @* Outside the head, so it stays at the top of the screen for the whole page (sticky only works inside its parent). *@
    <partial name="_BuilderSteps" model="currentStep" />

    @* Step 1 (F14, decision 2026-11-17): the budget field with "Chọn nhanh", the date and "Lưu" on one line, the notes
       under them. "Chọn nhanh" only fills the field: its amounts are links (/builder?chon=800000) that work without a
       script, and builder.ts fills the field in place. Nothing is saved without "Lưu". *@
    <form class="card budget-card" id="@Anchors.BudgetCard" method="post" action="@SiteLinks.BuilderPath" asp-antiforgery="true">
        <div class="budget-card__fields">
            <div class="field budget-card__budget">
                <label class="field__label" for="budget">Ngân sách của bạn</label>
                <div class="budget-card__pick">
                    <input class="input" id="budget" name="budget" type="text" inputmode="numeric" autocomplete="off" value="@Model.BudgetText" aria-invalid="@(budgetError is null ? null : "true")" aria-describedby="@(budgetError is null ? null : "budget-error")">
                    <button type="button" class="btn btn--outline picker-button" popovertarget="chon-nhanh"><partial name="_Icon" model='"wallet"' /><span>Chọn nhanh</span><partial name="_Icon" model='"chevron-down"' /></button>
                </div>
                @if (budgetError is not null)
                {
                    <p class="field__error" id="budget-error">@budgetError</p>
                }
            </div>

            <div class="field budget-card__date">
                <label class="field__label" for="delivery-date">Ngày giao hàng</label>
                <input class="input" id="delivery-date" name="deliveryDate" autofocus="@(Model.UsedHamper is not null && Model.Items is null)" type="date" value="@Model.DeliveryDateText" aria-invalid="@(dateError is null ? null : "true")" aria-describedby="@(dateError is null ? null : "delivery-date-error")">
                @if (dateError is not null)
                {
                    <p class="field__error" id="delivery-date-error">@dateError</p>
                }
            </div>

            <button type="submit" class="btn btn--primary budget-card__save">Lưu</button>
        </div>

        <p class="alert alert--warn budget-card__unsaved" id="chua-luu" role="status" hidden="@(Model.PickedBudgetVnd is null)">@(Model.PickedBudgetVnd is { } picked ? UnsavedNote(picked) : "")</p>
        <p class="budget-card__hint meta">Chúng tôi dùng ngày giao để kiểm tra hạn sử dụng của từng món. Tổng tiền do hệ thống tính và luôn hiện ở bên phải.</p>
    </form>

    <div class="picker-panel picker-panel--budget" id="chon-nhanh" popover role="dialog" aria-labelledby="chon-nhanh-ten">
        <div class="picker-panel__head">
            <h2 class="picker-panel__title" id="chon-nhanh-ten">Chọn nhanh ngân sách</h2>
            <button type="button" class="icon-btn" popovertarget="chon-nhanh" popovertargetaction="hide" aria-label="Đóng"><partial name="_Icon" model='"close"' /></button>
        </div>
        <ul class="picker-panel__amounts">
            @foreach (var amount in BudgetTiers.All)
            {
                var current = Model.BudgetText == Vnd.Format(amount);
                <li><a class="picker-tile picker-tile--amount" href="@ListLink(new() { ["chon"] = amount.ToString(System.Globalization.CultureInfo.InvariantCulture) }, Anchors.BudgetCard)" aria-current="@(current ? "true" : null)" data-amount="@Vnd.Format(amount)" data-note="@UnsavedNote(amount)">@Vnd.Short(amount)</a></li>
            }
        </ul>
        <p class="meta">Bấm một mức để điền vào ô ngân sách. Ngân sách chỉ đổi khi bạn bấm Lưu.</p>
    </div>

    @if (items is null)
    {
        @if (Model.UsedHamper is { } usedLocked)
        {
            <partial name="_UsedHamper" model="usedLocked" view-data='new ViewDataDictionary(ViewData) { ["Budget"] = Vnd.Format(Model.SavedBudgetVnd ?? 0) }' />
        }
        <p class="lock-note"><partial name="_Icon" model='"lock"' /><span>Nhập ngân sách và ngày giao hàng rồi bấm <strong>Lưu</strong> để mở bước chọn món và đóng gói. Chúng tôi cần ngày giao để ẩn những món sắp hết hạn.</span></p>
    }
    else
    {
        var showAllQuery = new Dictionary<string, string?>
        {
            ["category"] = items.Category, ["q"] = items.Search, ["sort"] = ItemSorts.ToQuery(items.Sort), ["inDate"] = "false", ["fit"] = items.FitBudget ? "true" : null,
        }.Where(p => !string.IsNullOrEmpty(p.Value));
        var showAll = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(SiteLinks.Builder.Href, showAllQuery) + Anchors.Link(Anchors.Items);
        // Where "Thêm", − and + post (BuilderController.Quantity), with the list's filters, so the visitor comes back to the same list.
        var listQuery = new Dictionary<string, string?>
        {
            ["category"] = items.Category, ["q"] = items.Search, ["sort"] = ItemSorts.ToQuery(items.Sort), ["inDate"] = items.OnlyInDate ? null : "false", ["fit"] = items.FitBudget ? "true" : null,
        }.Where(p => !string.IsNullOrEmpty(p.Value));
        var quantityAction = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(SiteLinks.QuantityPath, listQuery);
        var box = Model.Box!;
        var outOfDateLines = box.Lines.Count(l => !l.InDate);
        var sortLabels = new Dictionary<ItemSort, string>
        {
            [ItemSort.Default] = "Mặc định",
            [ItemSort.PriceAsc] = "Giá thấp đến cao",
            [ItemSort.PriceDesc] = "Giá cao đến thấp",
            [ItemSort.ExpiryLatest] = "Hạn dùng xa nhất",
            [ItemSort.NameAz] = "Tên A đến Z",
        };

        <div class="builder-main">
        <section class="items" id="@Anchors.Items" aria-labelledby="items-title">
            <h2 class="visually-hidden" id="items-title">Chọn món</h2>
            @if (Model.UsedHamper is { } used)
            {
                <partial name="_UsedHamper" model="used" />
            }

            @if (Model.Suggestions is { } suggestions)
            {
                <section class="suggest" id="@Anchors.Suggestions" aria-labelledby="goi-y-ten" data-row>
                    <div class="suggest__head">
                        <h2 class="suggest__title" id="goi-y-ten">Hộp gợi ý</h2>
                        <div class="row-buttons" hidden>
                            <button type="button" class="icon-btn row-buttons__btn" data-row-prev aria-label="Hộp gợi ý trước"><partial name="_Icon" model='"arrow-left"' /></button>
                            <button type="button" class="icon-btn row-buttons__btn" data-row-next aria-label="Hộp gợi ý sau"><partial name="_Icon" model='"arrow"' /></button>
                        </div>
                    </div>
                    <ul class="suggest__occasions" aria-label="Dịp">
                        @foreach (var o in suggestions.Occasions)
                        {
                            <li><a class="suggest__chip suggest__chip--@o.Accent" href="@ListLink(new() { ["dip"] = o.Id }, Anchors.Suggestions)" aria-current="@(o.Id == suggestions.Chosen.Id ? "true" : null)">@o.Name</a></li>
                        }
                    </ul>
                    <p class="suggest__text meta">
                        Hộp đến <strong>@Vnd.Format(suggestions.BudgetVnd)</strong>, theo ngân sách của bạn. Bắt đầu nhanh, rồi sửa tùy ý.
                        <a href="@SiteLinks.Occasion(suggestions.Chosen.Id)">Xem mọi mức ngân sách</a>
                    </p>
                    <ul class="suggest__row" data-row-track tabindex="0" aria-label="Hộp gợi ý @suggestions.Chosen.Name">
                        @foreach (var card in suggestions.Hampers)
                        {
                            <li class="suggest-card">
                                <div class="suggest-card__media">
                                    <img class="suggest-card__photo" src="@card.ImagePath" alt="" width="570" height="380" loading="lazy">
                                    <span class="card-go" aria-hidden="true"><partial name="_Icon" model='"arrow"' /></span>
                                </div>
                                <div class="suggest-card__body">
                                    <span class="suggest-card__who suggest-card__who--@suggestions.Chosen.Accent">@card.ForWhom</span>
                                    <h3 class="suggest-card__name"><a href="@SiteLinks.Hamper(card.Slug, Peekbox.Web.Controllers.OccasionsController.FromBuilder)">@card.Name</a></h3>
                                    <p class="meta">@card.Count món · @Vnd.Format(card.Quote.TotalVnd)</p>
                                    <partial name="_UseHamper" model='new UseHamperControl(card, Peekbox.Web.Controllers.OccasionsController.FromBuilder, box, "goi-y")' />
                                    <partial name="_ReplaceHamper" model='new UseHamperControl(card, Peekbox.Web.Controllers.OccasionsController.FromBuilder, box, "ask")' />
                                </div>
                            </li>
                        }
                    </ul>
                </section>
            }

            @* A plain GET form: search, sort and the checkbox reload the page with the filters in the address (works without
               scripts). "Danh mục" is a button that opens a panel of links, each keeping the other filters. *@
            <form class="item-filters" method="get" action="@(SiteLinks.Builder.Href + Anchors.Link(Anchors.Items))">
                @* Enter in the search box presses the first submit button of the form: this hidden one. *@
                <button type="submit" class="visually-hidden" tabindex="-1" aria-hidden="true">Tìm</button>

                <div class="item-filters__row">
                    <div class="field item-filters__category">
                        <span class="field__label" id="danh-muc-nhan">Danh mục</span>
                        @if (items.Chosen is { } chosen)
                        {
                            <div class="category-control category-control--chosen">
                                <button type="button" class="category-control__open" title="@chosen.Name" popovertarget="danh-muc" aria-labelledby="danh-muc-nhan danh-muc-gia-tri"><partial name="_Icon" model='"grid"' /><span id="danh-muc-gia-tri">@chosen.Name</span></button>
                                <a class="category-control__clear" href="@ListLink(new() { ["category"] = null }, Anchors.Items)" aria-label="Bỏ danh mục @chosen.Name, xem tất cả"><partial name="_Icon" model='"close"' /></a>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="category-control" popovertarget="danh-muc" aria-labelledby="danh-muc-nhan danh-muc-gia-tri"><partial name="_Icon" model='"grid"' /><span id="danh-muc-gia-tri">Tất cả</span><partial name="_Icon" model='"chevron-down"' /></button>
                        }
                    </div>
                    <div class="field item-filters__search">
                        <label class="field__label" for="item-search">Tìm món</label>
                        <div class="search-input">
                            <partial name="_Icon" model='"search"' />
                            <input class="input" id="item-search" name="q" type="search" value="@items.Search" maxlength="@ItemCatalog.SearchMaxLength" placeholder="Tên món, thương hiệu, xuất xứ" autocomplete="off">
                    </div>
                    </div>
                    <div class="field item-filters__sort">
                        <label class="field__label" for="item-sort">Sắp xếp</label>
                        <select class="input" id="item-sort" name="sort">
                            @foreach (var sort in ItemSorts.All)
                            {
                                <option value="@ItemSorts.ToQuery(sort)" selected="@(sort == items.Sort)">@sortLabels[sort]</option>
                            }
                        </select>
                    </div>
                    <noscript><button type="submit" class="btn btn--outline item-filters__apply">Lọc</button></noscript>
                </div>

                <div class="item-filters__check">
                    @* The framework's checkbox pattern, written by hand: a ticked box sends "true" before the hidden "false",
                       and model binding takes the first. (asp-for would also print an English "field is required" text.) *@
                    <input type="checkbox" id="in-date" name="inDate" value="true" checked="@items.OnlyInDate">
                    <input type="hidden" name="inDate" value="false">
                    <label for="in-date"><span>Chỉ món đủ hạn cho ngày giao <strong>@VnDate.Day(Model.SavedDeliveryDate!.Value)</strong></span></label>
                </div>
                @* "Vừa ngân sách": only the items that cost no more than what is left. Off unless ticked, so no hidden "false". *@
                <div class="item-filters__check">
                    <input type="checkbox" id="fit-budget" name="fit" value="true" checked="@items.FitBudget">
                    <label for="fit-budget"><span>Chỉ món vừa ngân sách còn lại <strong>@Vnd.Format(Math.Max(0, box.Quote.RemainingVnd))</strong></span></label>
                </div>
                @* The chosen category and occasion, so a search, a sort or the checkbox keeps them. *@
                <input type="hidden" name="category" value="@items.Category">
                <input type="hidden" name="dip" value="@ChosenOccasion()">
            </form>

            <div class="picker-panel picker-panel--category" id="danh-muc" popover role="dialog" aria-labelledby="danh-muc-ten">
                <div class="picker-panel__head">
                    <h2 class="picker-panel__title" id="danh-muc-ten">Chọn danh mục</h2>
                    <button type="button" class="icon-btn" popovertarget="danh-muc" popovertargetaction="hide" aria-label="Đóng"><partial name="_Icon" model='"close"' /></button>
                </div>
                <ul class="picker-panel__categories">
                    <li><a class="picker-tile" href="@ListLink(new() { ["category"] = null }, Anchors.Items)" aria-current="@(items.Category is null ? "true" : null)"><span class="picker-tile__name">Tất cả</span><span class="picker-tile__count">@items.TotalCount món</span></a></li>
                    @foreach (var chip in items.Categories)
                    {
                        <li><a class="picker-tile" href="@ListLink(new() { ["category"] = chip.Id }, Anchors.Items)" aria-current="@(chip.Id == items.Category ? "true" : null)"><span class="picker-tile__name">@chip.Name</span><span class="picker-tile__count">@chip.Count món</span>@if (chip.InBox > 0) {<span class="picker-tile__in-box" aria-label="@chip.InBox món trong hộp">✓ @chip.InBox</span>}</a></li>
                    }
                </ul>
                <p class="meta">Bấm một danh mục để xem ngay các món của nó. Dấu ✓ là số món của danh mục đã có trong hộp.</p>
            </div>

            @* Everything the search, the sort and the filters change: the count, the "no match" card and the rows or the grid.
               builder.ts swaps this whole block in as the visitor types (decision 2026-11-20). *@
            <div class="items__results" id="ket-qua">
                <p class="items__count">
                    <span>@(items.Chosen is { } shown ? $"{shown.Name}: hiện {items.Items.Count} món." : items.AsRows ? $"Hiện {items.Items.Count} món trong {items.Items.Select(i => i.CategoryId).Distinct().Count()} danh mục." : $"Hiện {items.Items.Count} món.")@if (items.HiddenCount > 0) {<text> @items.HiddenCount món hết hạn trước ngày giao đang được ẩn.</text>}</span>
                    @if (items.HiddenCount > 0)
                    {
                        <a href="@showAll">Hiện cả @items.HiddenCount món</a>
                    }
                </p>

                @if (items.Items.Count == 0)
                {
                    @* Mockup state 04. "Xóa bộ lọc" goes back to the plain list: all categories, no search, default order. *@
                    <div class="card no-match">
                        <p class="no-match__title">@(items.Search is null ? "Không có món nào phù hợp" : $"Không có món nào khớp \"{items.Search}\"")</p>
                        <p class="no-match__text">Thử bỏ bộ lọc hoặc tìm bằng từ khác.</p>
                        <a class="btn btn--outline" href="@(SiteLinks.Builder.Href + Anchors.Link(Anchors.Items))">Xóa bộ lọc</a>
                    </div>
                }

                @if (items.AsRows)
                {
                    @* "Tất cả": one sideways row per category, in the panel's order (decision 2026-11-17). The phone hint shows
                       until the first swipe (builder.ts remembers it in the browser). *@
                    <p class="rows-hint" id="vuot-hint" hidden>Vuốt sang trái để xem thêm món trong mỗi danh mục</p>
                    @foreach (var chip in items.Categories)
                    {
                        var rowItems = items.Items.Where(i => i.CategoryId == chip.Id).ToList();
                        if (rowItems.Count == 0)
                        {
                            continue;
                        }

                        var rowId = "hang-" + chip.Id;
                        var seeAll = ListLink(new() { ["category"] = chip.Id }, Anchors.Items);
                        <section class="item-row" id="@rowId" aria-labelledby="@rowId-ten" data-row>
                            <div class="item-row__head">
                                <h3 class="item-row__title" id="@rowId-ten">@chip.Name <span class="item-row__count">@rowItems.Count món</span>@if (chip.InBox > 0) {<span class="item-row__in-box">✓ @chip.InBox trong hộp</span>}</h3>
                                <a class="item-row__all" href="@seeAll">Xem tất cả</a>
                                <div class="row-buttons" hidden>
                                    <button type="button" class="icon-btn row-buttons__btn" data-row-prev aria-label="@chip.Name: món trước"><partial name="_Icon" model='"arrow-left"' /></button>
                                    <button type="button" class="icon-btn row-buttons__btn" data-row-next aria-label="@chip.Name: món sau"><partial name="_Icon" model='"arrow"' /></button>
                                </div>
                            </div>
                            <ul class="item-grid item-grid--row" data-row-track tabindex="0" aria-label="@chip.Name">
                                @foreach (var item in rowItems)
                                {
                                    <partial name="_ItemCard" model="new ItemCardView(item, quantityAction)" />
                                }
                                <li class="item-row__end"><a href="@seeAll">Xem tất cả @chip.Name<partial name="_Icon" model='"arrow"' /></a></li>
                            </ul>
                            <div class="item-row__position" aria-hidden="true"><span class="item-row__bar"><span class="item-row__fill" data-row-fill></span></span><span data-row-text>@rowItems.Count món</span></div>
                        </section>
                    }
                }
                else
                {
                    <ul class="item-grid">
                        @foreach (var item in items.Items)
                        {
                            <partial name="_ItemCard" model="new ItemCardView(item, quantityAction)" />
                        }
                    </ul>
                }
            </div>

            @if (box.Lines.Count == 0)
            {
                @* Step 3 is locked until the box holds an item; nothing is drawn below the note (mockup 26). *@
                <p class="lock-note" id="packaging-lock"><partial name="_Icon" model='"lock"' /><span>Chọn ít nhất <strong>1 món</strong> để mở bước đóng gói.</span></p>
            }
            else
            {
                @* Step 3 (F33, mockup 27). A plain form: builder.ts sends it as soon as the choice changes; without scripts
                   the "Lưu" button does. "Tiếp tục" in the panel and the phone bar belongs to this form too (form="dong-goi-form"). *@
                <section class="card packaging" id="@Anchors.Packaging" aria-labelledby="packaging-title">
                    <form id="dong-goi-form" method="post" action="@SiteLinks.PackagingPath" asp-antiforgery="true">
                        <fieldset class="packaging__set">
                            <legend><h2 class="packaging__title" id="packaging-title">Chọn kiểu đóng gói</h2></legend>
                            <div class="packaging__options">
                                @foreach (var option in Model.Packagings)
                                {
                                    <label class="packaging-option" for="dong-goi-@option.Id">
                                        <img class="packaging-option__img" src="@option.ImagePath" alt="" width="600" height="448" loading="lazy">
                                        <span class="packaging-option__head">
                                            <input type="radio" id="dong-goi-@option.Id" name="packaging" value="@option.Id" checked="@(option.Id == box.Packaging!.Id)">
                                            <span class="packaging-option__name">@option.Name</span>
                                        </span>
                                        <span class="packaging-option__desc meta">@option.Description</span>
                                        <span class="packaging-option__fee">@(option.FeeVnd == 0 ? "Miễn phí" : "+" + Vnd.Format(option.FeeVnd))</span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                        <noscript><button type="submit" class="btn btn--outline packaging__save">Lưu kiểu đóng gói</button></noscript>
                    </form>
                </section>
            }
        </section>

        @* "Hộp của bạn" (F20, F21). Every number comes from the server (Pricing); this view only formats them. From 900 px it
           stays beside the items and its list of lines scrolls inside it, so "Tiếp tục" is always on screen. On a phone it
           is a popover: hidden until "Xem hộp" on the bar opens it as a sheet from the bottom (decision 2026-11-17). *@
        <aside class="card box-panel" id="hop-cua-ban" aria-labelledby="box-title" popover>
            <div class="box-panel__head">
                <h2 class="box-panel__title" id="box-title"><span>Hộp của bạn</span>@if (box.Count > 0) {<span class="box-panel__count"> · @box.Count món</span>}</h2>
                <button type="button" class="icon-btn box-panel__close" popovertarget="hop-cua-ban" popovertargetaction="hide" aria-label="Đóng"><partial name="_Icon" model='"close"' /></button>
            </div>
            @if (box.StartedFrom is { } from)
            {
                <p class="box-panel__from">Bạn đang sửa <strong>@from</strong>. Đổi món tùy ý; hạn dùng vẫn được kiểm tra.</p>
            }
            @if (box.Lines.Count > 0)
            {
                <ul class="box-lines">
                    @foreach (var line in box.Lines)
                    {
                        <li class="box-line" id="hop-@line.Slug">
                            <img class="box-line__img" src="@line.ImagePath" alt="" width="508" height="508" loading="lazy">
                            <p class="box-line__head"><span class="box-line__name">@line.Name</span><span>@Vnd.Format(line.LineVnd)</span></p>
                            <div class="box-line__foot">
                                <p class="box-line__meta">@line.WeightGrams g · @VnDate.Expiry(line.ExpiryDate)</p>
                                <partial name="_QuantityControl" model="new QuantityControl(quantityAction, line.Slug, line.Name, line.Quantity, line.NextStatus, 0, false)" />
                            </div>
                            @if (!line.InDate)
                            {
                                <span class="badge badge--warn">HSD @VnDate.Day(line.ExpiryDate!.Value), trước ngày giao</span>
                            }
                        </li>
                    }
                </ul>
            }
            @* The sheet on a phone shows the sums on one line instead of the block below, so more lines fit. *@
            <p class="box-panel__compact"><span>@box.Count món · @(box.Quote.OverBudget ? "Vượt" : "Còn lại") <strong>@Vnd.Format(box.LeftOrOverVnd)</strong></span><strong>@Vnd.Format(box.Quote.TotalVnd)</strong></p>
            <dl class="box-sums">
                @if (box.Packaging is { } packaging)
                {
                    <div class="box-sums__row"><dt>Đóng gói: @packaging.Name</dt><dd>@Vnd.Format(packaging.FeeVnd)</dd></div>
                }
                else
                {
                    <div class="box-sums__row"><dt>Đóng gói: chưa chọn</dt><dd>–</dd></div>
                }
                <div class="box-sums__row"><dt>Ngân sách</dt><dd>@Vnd.Format(box.BudgetVnd)</dd></div>
                <div class="box-sums__bar"><meter class="budget-meter" min="0" max="@Math.Max(box.BudgetVnd, 1)" value="@box.Quote.GoodsVnd" aria-hidden="true"></meter></div>
                @if (box.Quote.OverBudget)
                {
                    <div class="box-sums__row box-sums__row--over"><dt>Vượt ngân sách</dt><dd>@Vnd.Format(box.LeftOrOverVnd)</dd></div>
                }
                else
                {
                    <div class="box-sums__row box-sums__row--left"><dt>Còn lại</dt><dd>@Vnd.Format(box.LeftOrOverVnd)</dd></div>
                }
                <div class="box-sums__row box-sums__row--total"><dt>Tổng cộng (đã gồm thuế)</dt><dd>@Vnd.Format(box.Quote.TotalVnd)</dd></div>
            </dl>
            @if (box.Lines.Count == 0)
            {
                <p class="box-panel__note">Chưa có món nào trong hộp.</p>
            }
            else if (outOfDateLines == 0)
            {
                <partial name="_InDateNote" model="new InDateNote(box.Lines, Model.SavedDeliveryDate!.Value)" />
            }
            else
            {
                <p class="box-panel__note box-panel__note--warn">@outOfDateLines món hết hạn trước ngày giao. Bỏ món đó ra hoặc đổi ngày giao.</p>
            }
            @if (box.Lines.Count > 0)
            {
                @* F24: saves the packaging on screen, then opens the review page. *@
                <button type="submit" class="btn btn--primary box-panel__next" form="dong-goi-form" name="next" value="@ReturnTo.Review.Value()">Tiếp tục: xem lại hộp quà</button>
            }
            else
            {
                <button type="button" class="btn btn--primary box-panel__next" disabled aria-describedby="next-empty">Tiếp tục: xem lại hộp quà</button>
                <p class="box-panel__soon" id="next-empty">Chọn ít nhất 1 món để tiếp tục.</p>
            }
        </aside>
        </div>

        @* Phone: the box as a bar fixed to the bottom of the screen (mockups 26 and 27, phone). *@
        <div class="box-bar" aria-label="Tóm tắt hộp quà" role="region">
            <p class="box-bar__sums">
                @if (box.Lines.Count > 0)
                {
                    <button type="button" class="btn btn--outline box-bar__open" popovertarget="hop-cua-ban"><partial name="_Icon" model='"chevron-up"' />Xem hộp (@box.Count)</button>
                }
                <span>@(box.Lines.Count > 0 ? "" : $"{box.Count} món · ")@(box.Quote.OverBudget ? "Vượt" : "Còn lại") <strong>@Vnd.Format(box.LeftOrOverVnd)</strong></span><strong class="box-bar__total">@Vnd.Format(box.Quote.TotalVnd)</strong>
            </p>
            <meter class="budget-meter" min="0" max="@Math.Max(box.BudgetVnd, 1)" value="@box.Quote.GoodsVnd" aria-hidden="true"></meter>
            @if (box.Lines.Count > 0)
            {
                <button type="submit" class="btn btn--primary box-bar__next" form="dong-goi-form" name="next" value="@ReturnTo.Review.Value()">Xem lại hộp quà</button>
            }
            else
            {
                <button type="button" class="btn btn--primary box-bar__next" disabled aria-describedby="next-empty-bar">Xem lại hộp quà</button>
                <p class="visually-hidden" id="next-empty-bar">Chọn ít nhất 1 món để tiếp tục.</p>
            }
        </div>

        @* builder.ts writes here what changed after "Thêm", − or +, for screen readers, and shows the same words for a few
           seconds in the toast (hidden from screen readers, which hear the status). *@
        <p class="visually-hidden" id="box-status" role="status"></p>
        @* A manual popover, so it shows above the phone's open sheet (both are in the top layer; the last shown is on top). *@
        <p class="box-toast" id="box-toast" aria-hidden="true" popover="manual"></p>
    }
</div>
