@using Peekbox.Web.Formatting
@using Peekbox.Web.Services
@model ReviewSummary
@* "Tổng kết" (F36, mockups 04, 29 and 30). Every number comes from the server (Pricing); this view only formats them. *@
@{
    var box = Model.Box;
    var outOfDate = box.OutOfDate.Count;
    var reasonId = "cart-reason" + Model.IdSuffix;
}
<dl class="box-sums review-sums">
    <div class="box-sums__row"><dt>@box.Count món</dt><dd>@Vnd.Format(box.Quote.GoodsVnd)</dd></div>
    <div class="box-sums__row"><dt>@box.Packaging!.Name</dt><dd>@Vnd.Format(box.Quote.PackagingVnd)</dd></div>
    <div class="box-sums__row review-sums__budget"><dt>Ngân sách</dt><dd>@Vnd.Format(box.BudgetVnd)</dd></div>
    <div class="box-sums__bar"><meter class="budget-meter" min="0" max="@Math.Max(box.BudgetVnd, 1)" value="@box.Quote.GoodsVnd" aria-hidden="true"></meter></div>
    @if (box.Quote.OverBudget)
    {
        <div class="box-sums__row box-sums__row--over"><dt>Vượt ngân sách</dt><dd>@Vnd.Format(box.LeftOrOverVnd)</dd></div>
    }
    else
    {
        <div class="box-sums__row box-sums__row--left"><dt>Còn lại</dt><dd>@Vnd.Format(box.LeftOrOverVnd)</dd></div>
    }
    <div class="box-sums__row box-sums__row--total"><dt>Tổng cộng (đã gồm thuế)</dt><dd>@Vnd.Format(box.Quote.TotalVnd)</dd></div>
</dl>
<p class="review-summary__fee">Phí giao hàng sẽ tính ở bước thanh toán, theo phường và ngày giao.</p>
@if (outOfDate == 0)
{
    <p class="box-panel__note">Cả @box.Lines.Count món đều còn hạn đến sau ngày giao @VnDate.Day(box.DeliveryDate!.Value) cộng @BuilderLimits.ShelfMarginDays ngày dự phòng.</p>
}
@* The cart is the next slice, so the button is off and says why; an out-of-date item is the reason that comes first (F35). *@
<button type="button" class="btn btn--primary review-summary__cart" disabled aria-describedby="@reasonId">Thêm vào giỏ hàng</button>
@if (outOfDate > 0)
{
    <p class="review-summary__reason review-summary__reason--block" id="@reasonId">Bỏ món hết hạn hoặc đổi ngày giao để tiếp tục.</p>
}
else
{
    <p class="review-summary__reason" id="@reasonId">Giỏ hàng sẽ có trong bản sau.</p>
}
