@using Peekbox.Web.Formatting
@using Peekbox.Web.Services
@model Box
@{
    ViewData["Title"] = "Xem lại hộp quà";
    ViewData[Crumbs.ViewDataKey] = Crumbs.Trail(Crumbs.To(SiteLinks.Builder), Crumbs.Here("Xem lại hộp quà"));
    ViewData["Nav"] = SiteLinks.Builder.Key;
    var packaging = Model.Packaging!;
    var outOfDate = Model.OutOfDate;
    var delivery = VnDate.Day(Model.DeliveryDate!.Value);
    var columnSummary = new ReviewSummary(Model, "");
    var sheetSummary = new ReviewSummary(Model, "-sheet");
    var lines = new HamperLines(Model, ReturnTo.Review);
}

@section Styles {
    <link rel="stylesheet" href="~/css/builder.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/review.css" asp-append-version="true">
}

@* Step 4 (F34 to F36, mockups 04, 29 and 30): the hamper read-only, with links back to change it (decision 2026-11-15). *@
<div class="builder review">
    <div class="builder__head">
        <h1 class="builder__title">Xem lại hộp quà</h1>
    </div>
    @* Outside the head, so it stays at the top of the screen for the whole page (sticky only works inside its parent). *@
    <partial name="_BuilderSteps" model="3" />

    @if (outOfDate.Count > 0)
    {
        <partial name="_OutOfDateBlock" model="Model" />
    }

    <div class="review-main">
        <div class="review-cards">
            <section class="card review-card" aria-labelledby="budget-title">
                <div class="review-card__head">
                    <h2 class="review-card__title" id="budget-title">Ngân sách và ngày giao</h2>
                    <a class="review-card__edit" href="@SiteLinks.Builder.Href" aria-label="Sửa ngân sách và ngày giao">Sửa</a>
                </div>
                <dl class="review-facts">
                    <div><dt>Ngân sách</dt><dd>@Vnd.Format(Model.BudgetVnd)</dd></div>
                    <div><dt>Ngày giao hàng</dt><dd>@delivery</dd></div>
                </dl>
            </section>

            <section class="card review-card" aria-labelledby="packaging-title">
                <div class="review-card__head">
                    <h2 class="review-card__title" id="packaging-title">Kiểu đóng gói</h2>
                    <a class="review-card__edit" href="@(SiteLinks.Builder.Href + Anchors.Link(Anchors.Packaging))" aria-label="Đổi kiểu đóng gói">Đổi</a>
                </div>
                <partial name="_PackagingRow" model="packaging" />
            </section>

            <section class="card review-card" aria-labelledby="lines-title">
                <h2 class="review-card__title" id="lines-title">Các món trong hộp</h2>
                <partial name="_HamperLines" model="lines" />
                <a class="review-card__back" href="@(SiteLinks.Builder.Href + Anchors.Link(Anchors.Items))">Quay lại chỉnh sửa món</a>
            </section>
        </div>

        @* Wide screens: the summary in the right column. *@
        <aside class="card review-summary" aria-labelledby="summary-title">
            <h2 class="review-summary__title" id="summary-title">Tổng kết</h2>
            <partial name="_ReviewSummary" model="columnSummary" />
        </aside>
    </div>

    @* Phone: a bar at the bottom of the screen; "Xem tổng kết" opens the summary as a sheet (mockup 29). The sheet is a
       popover, which the browser opens and closes without a script (Escape and a tap outside close it too). *@
    <div class="review-bar" data-bottom-bar role="region" aria-label="Tổng kết hộp quà">
        <p class="review-bar__line">
            <button type="button" class="review-bar__open" popovertarget="tong-ket" aria-controls="tong-ket">Xem tổng kết <partial name="_Icon" model='"chevron-up"' /></button>
            <span>@Model.Count món · @(Model.Quote.OverBudget ? "Vượt" : "Còn lại") <strong>@Vnd.Format(Model.LeftOrOverVnd)</strong></span>
        </p>
        <div class="review-bar__foot">
            <p class="review-bar__total"><span>Tổng cộng</span> <strong>@Vnd.Format(Model.Quote.TotalVnd)</strong></p>
            @if (outOfDate.Count > 0)
            {
                <button type="button" class="btn btn--primary review-bar__cart" disabled aria-describedby="cart-reason-bar">Thêm vào giỏ hàng</button>
                <p class="visually-hidden" id="cart-reason-bar">Bỏ món hết hạn hoặc đổi ngày giao để tiếp tục.</p>
            }
            else
            {
                <form class="review-bar__add" method="post" action="@SiteLinks.CartAddPath" asp-antiforgery="true">
                    <button type="submit" class="btn btn--primary review-bar__cart">Thêm vào giỏ hàng</button>
                </form>
            }
        </div>
    </div>

    <div class="review-sheet" id="tong-ket" popover role="dialog" aria-labelledby="sheet-title">
        <div class="review-sheet__head">
            <h2 class="review-summary__title" id="sheet-title">Tổng kết</h2>
            <button type="button" class="review-sheet__close" popovertarget="tong-ket" popovertargetaction="hide">Thu gọn <partial name="_Icon" model='"chevron-down"' /></button>
        </div>
        <partial name="_ReviewSummary" model="sheetSummary" />
    </div>
</div>
