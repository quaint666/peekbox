@using Peekbox.Web.Data
@using Peekbox.Web.Formatting
@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
    ViewData[Crumbs.ViewDataKey] = Crumbs.Trail(Crumbs.Here(SiteLinks.Cart.Label));
    ViewData["Nav"] = SiteLinks.Cart.Key;
}

@section Styles {
    <link rel="stylesheet" href="~/css/review.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/cart.css" asp-append-version="true">
}

@* The cart (F37, F39, F40; mockups 05 and state 01, as redrawn 2026-11-16). The cart is the visitor's hamper once it
   holds an item; every number comes from the server (Pricing). *@
<div class="cart">
    <h1 class="cart__title">Giỏ hàng</h1>

    @if (Model.Box is not { } box)
    {
        <section class="card cart-empty" aria-labelledby="empty-title">
            <span class="cart-empty__icon"><img class="logo--light" src="~/images/logo/peekbox-mark-sage.svg" alt="" width="48" height="44"><img class="logo--dark" src="~/images/logo/peekbox-mark-dark.svg" alt="" width="48" height="44"></span>
            <h2 class="cart-empty__title" id="empty-title">Giỏ hàng đang trống</h2>
            <p class="cart-empty__text">Hãy đặt ngân sách trước, rồi chọn từng món. Peekbox sẽ cho bạn thấy còn lại bao nhiêu sau mỗi món.</p>
            <a class="btn btn--primary cart-empty__go" href="@SiteLinks.Builder.Href">Tạo hộp quà</a>
        </section>
    }
    else
    {
        var packaging = box.Packaging!;
        var when = box.DeliveryDate is { } date ? $"Giao ngày {VnDate.Day(date)}" : "Chưa chọn ngày giao";
        var lines = new HamperLines(box, ReturnTo.Cart);
        var reason = Model.CheckoutReason;   // null: the box can go to checkout

        @if (box.OutOfDate.Count > 0)
        {
            <partial name="_OutOfDateBlock" model="box" />
        }

        <div class="review-main">
            <section class="card cart-box" aria-labelledby="box-title">
                <div class="cart-box__head">
                    <div class="cart-box__heading">
                        <h2 class="cart-box__title" id="box-title">Hộp quà của bạn</h2>
                        <p class="cart-box__meta meta">@when · @packaging.Name · Ngân sách @Vnd.Format(box.BudgetVnd)</p>
                    </div>
                    <div class="cart-box__actions">
                        <a class="btn btn--outline" href="@(SiteLinks.Builder.Href + Anchors.Link(Anchors.Items))">Sửa hộp</a>
                        @* Asks first (decision 2026-11-16): the popover opens and closes without a script. *@
                        <button type="button" class="btn btn--outline cart-box__clear" popovertarget="xoa-hop">Xóa hộp</button>
                    </div>
                </div>
                <partial name="_HamperLines" model="lines" />
                <div class="cart-box__pack">
                    <div class="review-card__head">
                        <h3 class="cart-box__subtitle">Kiểu đóng gói</h3>
                        <a class="review-card__edit" href="@(SiteLinks.Builder.Href + Anchors.Link(Anchors.Packaging))" aria-label="Đổi kiểu đóng gói">Đổi</a>
                    </div>
                    <partial name="_PackagingRow" model="packaging" />
                </div>
            </section>

            <aside class="card cart-summary" aria-labelledby="summary-title">
                <h2 class="cart-summary__title" id="summary-title">Tổng kết</h2>
                <dl class="cart-sums">
                    <div><dt>Tiền hàng (@box.Count món)</dt><dd>@Vnd.Format(box.Quote.GoodsVnd)</dd></div>
                    <div><dt>Đóng gói</dt><dd>@Vnd.Format(box.Quote.PackagingVnd)</dd></div>
                    @if (box.Coupon is { Works: true } applied)
                    {
                        <div class="cart-sums__discount"><dt>Mã @applied.Code (@applied.Label.ToLowerInvariant())</dt><dd>−@Vnd.Format(applied.DiscountVnd)</dd></div>
                    }
                    <div class="cart-sums__later"><dt>Phí giao hàng</dt><dd>Tính ở bước sau</dd></div>
                </dl>
                @* F38: the discount code. A code that works is kept on the hamper; one that does not says why under the field. *@
                <div class="cart-coupon" id="@Anchors.Coupon">
                    @if (box.Coupon is { } code)
                    {
                        <div class="cart-coupon__applied">
                            <p class="cart-coupon__code"><span class="meta">Mã giảm giá</span><strong>@code.Code</strong>@if (code.Works) {<span class="meta">@code.Label</span>}</p>
                            <form method="post" action="@SiteLinks.CartCouponRemovePath" asp-antiforgery="true"><button type="submit" class="btn btn--outline cart-coupon__btn" aria-label="Bỏ mã @code.Code">Bỏ mã</button></form>
                        </div>
                        @if (code.Note is { } note)
                        {
                            <p class="field__error" role="alert">@note</p>
                        }
                    }
                    else
                    {
                        <form class="cart-coupon__form" method="post" action="@SiteLinks.CartCouponPath" asp-antiforgery="true">
                            <label class="field__label" for="coupon-code">Mã giảm giá</label>
                            <div class="cart-coupon__row">
                                <input class="input" id="coupon-code" name="code" value="@Model.CouponTyped" maxlength="@Coupon.CodeMaxLength" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-invalid="@(Model.CouponError is null ? null : "true")" aria-describedby="@(Model.CouponError is null ? null : "coupon-code-error")">
                                <button type="submit" class="btn btn--outline cart-coupon__btn">Áp dụng</button>
                            </div>
                            @if (Model.CouponError is { } error)
                            {
                                <p class="field__error" id="coupon-code-error" role="alert">@error</p>
                            }
                        </form>
                    }
                </div>
                @* Wide screens; on a phone the total and the button are in the bar below (mockup 05, phone). *@
                <div class="cart-summary__end">
                    <p class="cart-total"><span>Tạm tính (đã gồm thuế)</span><strong>@Vnd.Format(box.PayVnd)</strong></p>
                    @if (reason is not null)
                    {
                        <button type="button" class="btn btn--primary cart-checkout" disabled aria-describedby="checkout-reason">Tiếp tục thanh toán</button>
                        <p class="cart-reason meta@(Model.Blocked ? " cart-reason--block" : "")" id="checkout-reason">@reason</p>
                    }
                    else
                    {
                        <a class="btn btn--primary cart-checkout" href="@SiteLinks.CheckoutPath">Tiếp tục thanh toán</a>
                    }
                </div>
            </aside>
        </div>

        <div class="cart-bar" role="region" aria-label="Tạm tính">
            <p class="cart-total"><span>Tạm tính (đã gồm thuế)</span><strong>@Vnd.Format(box.PayVnd)</strong></p>
            @if (reason is not null)
            {
                <button type="button" class="btn btn--primary cart-checkout" disabled aria-describedby="checkout-reason-bar">Tiếp tục thanh toán</button>
                <p class="cart-reason meta@(Model.Blocked ? " cart-reason--block" : "")" id="checkout-reason-bar">@reason</p>
            }
            else
            {
                <a class="btn btn--primary cart-checkout" href="@SiteLinks.CheckoutPath">Tiếp tục thanh toán</a>
            }
        </div>

        <partial name="_ConfirmClear" model='new ConfirmClear("xoa-hop", ReturnTo.Cart)' />
    }
</div>
