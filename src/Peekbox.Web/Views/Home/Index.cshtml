@model HomeViewModel
@{
    ViewData["Nav"] = SiteLinks.Home.Key;
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
}

@section Banner {
    @* TODO(F05, M5): the banner text should come from the active campaign, not be typed here. *@
    <p class="home-banner">Mùa Tết 2027: chọn hộp quà và ngày giao sớm để còn nhiều lựa chọn</p>
}

<section class="hero">
    <div class="container hero__inner">
        <div>
            <p class="badge hero__badge">
                <span class="hero__dot hero__dot--tet" aria-hidden="true"></span>
                <span class="hero__dot hero__dot--teachers" aria-hidden="true"></span>
                <span class="hero__dot hero__dot--women" aria-hidden="true"></span>
                @Model.Content.Pill
            </p>
            <h1 class="hero__title">@Model.Content.Title</h1>
            <p class="hero__lead">@Model.Content.Lead</p>
            <div class="hero__actions">
                <a class="btn btn--lg btn--primary" href="@SiteLinks.Builder.Href">@Model.Content.PrimaryButton</a>
                <a class="btn btn--lg btn--outline" href="@SiteLinks.Commitments.Href">@Model.Content.SecondaryButton</a>
            </div>
        </div>
        <img class="hero__image" src="~/images/hero.webp" asp-append-version="true"
             width="1200" height="896"
             alt="@Model.Content.ImageAlt">
    </div>
</section>

<section class="promises" aria-label="@Model.Content.PromisesLabel">
    <div class="container promises__inner">
        @foreach (var promise in Model.Content.Promises)
        {
            <div class="promise">
                <span class="promise__icon"><partial name="_Icon" model="promise.Icon" /></span>
                <div>
                    <h2 class="promise__title">@promise.Title</h2>
                    <p class="promise__text">@promise.Text</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="steps">
    <div class="container steps__inner">
        <h2 class="steps__title">@Model.Content.StepsTitle</h2>
        <ol class="steps__list">
            @for (var i = 0; i < Model.Content.Steps.Count; i++)
            {
                var step = Model.Content.Steps[i];
                <li class="step">
                    <span class="step__label">@Model.Content.StepLabel @(i + 1)</span>
                    <strong class="step__title">@step.Title</strong>
                    <span class="step__text">@step.Text</span>
                </li>
            }
        </ol>
    </div>
</section>

<section class="occasions">
    <div class="container occasions__inner">
        <h2 class="occasions__title">@Model.Content.OccasionsTitle</h2>
        <ul class="occasions__list">
            @foreach (var occasion in Model.Content.Occasions)
            {
                <li class="occasion occasion--@occasion.Accent">
                    <div class="occasion__bar"></div>
                    <div class="occasion__body">
                        <h3 class="occasion__name">@occasion.Name</h3>
                        <p class="occasion__text">@occasion.Text</p>
                        <a class="occasion__link" href="@SiteLinks.Builder.Href">@Model.Content.OccasionsLink</a>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

<section class="cta">
    <div class="container cta__inner">
        <p class="cta__text">@Model.Content.ClosingText</p>
        <a class="btn btn--lg cta__button" href="@SiteLinks.Builder.Href">@Model.Content.ClosingButton</a>
    </div>
</section>
