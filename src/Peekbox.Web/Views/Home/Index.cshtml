@model HomeViewModel
@{
    ViewData["Nav"] = SiteLinks.Home.Key;
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
}

@section Banner {
    @* TODO(F05, M5): the banner text should come from the active campaign, not be typed here. *@
    <p class="home-banner">Mùa Tết 2027: chọn hộp quà và ngày giao sớm để còn nhiều lựa chọn</p>
}

<section class="hero">
    <div class="container hero__inner">
        <div>
            <p class="badge hero__badge">
                <span class="hero__dot hero__dot--tet" aria-hidden="true"></span>
                <span class="hero__dot hero__dot--teachers" aria-hidden="true"></span>
                <span class="hero__dot hero__dot--women" aria-hidden="true"></span>
                @Model.Content.Pill
            </p>
            <h1 class="hero__title">@Model.Content.Title</h1>
            <p class="hero__lead">@Model.Content.Lead</p>
            <div class="hero__actions">
                <a class="btn btn--lg btn--primary" href="@SiteLinks.Builder.Href">@Model.Content.PrimaryButton</a>
                <a class="btn btn--lg btn--outline" href="@SiteLinks.Commitments.Href">@Model.Content.SecondaryButton</a>
            </div>
        </div>
        <img class="hero__image" src="~/images/hero.webp" asp-append-version="true"
             width="1200" height="896"
             alt="@Model.Content.ImageAlt">
    </div>
</section>
