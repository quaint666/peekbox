@{
    var active = ViewData["Nav"] as string;
}
<header class="site-header">
    <div class="site-header__inner container">
        @* The link carries the name: CSS hides one of the two logos, and a hidden image's alt text is not read, so with
           the name on an image the link had none in one theme. 110 × 34: the logos' shape (2102 × 648). *@
        <a class="site-header__brand" href="@SiteLinks.Home.Href" aria-label="Peekbox, trang chủ">
            <img class="logo logo--light" src="~/images/logo/peekbox-logo-sage.svg" alt="" width="110" height="34">
            <img class="logo logo--dark" src="~/images/logo/peekbox-logo-dark.svg" alt="" width="110" height="34">
        </a>
        <nav class="site-nav" id="site-nav" aria-label="Menu chính">
            @foreach (var link in SiteLinks.Header)
            {
                if (link.Key == SiteLinks.Occasions.Key)
                {
                    <div class="site-nav__dip">
                        <a href="@link.Href">@link.Label</a>
                        @await Component.InvokeAsync("OccasionLinks", new { variant = "Menu" })
                    </div>
                }
                else
                {
                    <a href="@link.Href" aria-current="@(link.Key == active ? "page" : null)">@link.Label</a>
                }
            }
        </nav>
        <div class="site-header__tools">
            <button type="button" class="icon-btn" data-action="toggle-theme" aria-label="Đổi giao diện sáng hoặc tối">
                <partial name="_Icon" model='"moon"' />
                <partial name="_Icon" model='"sun"' />
            </button>
            @await Component.InvokeAsync("CartLink", new { current = active == SiteLinks.Cart.Key })
            <button type="button" class="icon-btn menu-btn" data-action="toggle-menu" aria-expanded="false" aria-controls="site-nav" aria-label="Mở menu" data-label-open="Mở menu" data-label-close="Đóng menu">
                <partial name="_Icon" model='"menu"' />
                <partial name="_Icon" model='"close"' />
            </button>
        </div>
    </div>
</header>
