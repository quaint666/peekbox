@using Peekbox.Web.Formatting
@model HamperLines
@* The hamper's items, read-only (review page, mockups 04 and 30; cart, mockup 05). Only a line that expires before the
   delivery date has a button: "Bỏ món này" (F35), which posts to /builder/quantity and comes back to this page. *@
<ul class="review-lines">
    @foreach (var line in Model.Box.Lines)
    {
        <li class="review-line@(line.InDate ? "" : " review-line--expired")">
            <img class="review-line__img" src="@line.ImagePath" alt="" width="508" height="508" loading="lazy">
            <p class="review-line__name">@line.Name</p>
            <p class="review-line__price">
                @if (line.Quantity > 1)
                {
                    <span class="review-line__each">@line.Quantity × @Vnd.Format(line.PriceVnd)</span>
                }
                <strong>@Vnd.Format(line.LineVnd)</strong>
            </p>
            <div class="review-line__details">
                <p class="review-line__meta meta">@line.Brand · @line.WeightGrams g · Xuất xứ @line.Origin</p>
                @if (line.ExpiryDate is null)
                {
                    <span class="badge badge--muted">@VnDate.NoExpiry</span>
                }
                else if (line.InDate)
                {
                    <span class="badge">HSD @VnDate.Month(line.ExpiryDate.Value) · đủ hạn</span>
                }
                else
                {
                    <span class="badge badge--danger">HSD @VnDate.Day(line.ExpiryDate.Value), hết hạn trước ngày giao</span>
                }
            </div>
            @if (!line.InDate)
            {
                <form class="review-line__remove" method="post" action="@SiteLinks.Quantity(Model.From)" asp-antiforgery="true">
                    <input type="hidden" name="slug" value="@line.Slug">
                    <button type="submit" class="btn btn--danger" name="quantity" value="0" aria-label="Bỏ @line.Name khỏi hộp">Bỏ món này</button>
                </form>
            }
        </li>
    }
</ul>
