@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    @if (ViewData["NoIndex"] is true)
    {
        @* Checkout, the sold-out notice and an order's page: nothing a search engine should list (the order page's address holds its secret token). *@
        <meta name="robots" content="noindex">
    }
    <title>@(string.IsNullOrEmpty(title) ? "Peekbox" : $"{title} · Peekbox")</title>
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" type="image/svg+xml" href="~/images/logo/peekbox-mark-sage.svg">
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/theme-init.js" asp-append-version="true"></script>
</head>
<body>
    <a class="skip-link" href="#main">Bỏ qua và vào nội dung</a>
    @await RenderSectionAsync("Banner", required: false)
    <partial name="_Header" />
    @if (ViewData[Crumbs.ViewDataKey] is IReadOnlyList<Crumb> crumbs)
    {
        <partial name="_Breadcrumb" model="crumbs" />
    }
    <main id="main" class="@(ViewData["FullWidth"] is true ? null : "container page")">
        @RenderBody()
    </main>
    <partial name="_Footer" />
    <script type="module" src="~/js/layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
