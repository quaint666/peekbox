@inject Peekbox.Web.Services.ShopInfo shop
<footer class="site-footer">
    <div class="site-footer__main container">
        <div class="site-footer__brand">
            <strong class="site-footer__name">Peekbox</strong>
            <p class="site-footer__tagline">Hộp quà theo ngân sách cho các dịp lễ trong năm.</p>
            <div class="site-footer__social">
                <a href="@shop.PhoneLink" aria-label="Gọi điện">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </a>
                <a href="@shop.ZaloUrl" target="_blank" rel="noopener" aria-label="Chat qua Zalo (mở trang mới)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </a>
            </div>
        </div>
        <nav class="site-footer__links" aria-labelledby="footer-explore">
            <h2 class="site-footer__title" id="footer-explore">Khám phá</h2>
            @foreach (var link in SiteLinks.FooterExplore)
            {
                <a href="@link.Href">@link.Label</a>
            }
        </nav>
        <nav class="site-footer__links" aria-labelledby="footer-dip">
            <h2 class="site-footer__title" id="footer-dip">Dịp</h2>
            @await Component.InvokeAsync("OccasionLinks", new { variant = "Footer" })
        </nav>
        <div class="site-footer__contact">
            <h2 class="site-footer__title">Liên hệ</h2>
            <a href="@shop.PhoneLink">@shop.Phone</a>
            <a href="@shop.EmailLink">@shop.Email</a>
            <span>@shop.Address</span>
        </div>
    </div>
    <div class="site-footer__bottom">
        <div class="site-footer__bottom-inner container">
            <p class="site-footer__copy">© Peekbox. @Brand.Slogan.</p>
            <nav class="site-footer__legal" aria-label="Pháp lý">
                @for (var i = 0; i < SiteLinks.FooterLegal.Count; i++)
                {
                    if (i > 0)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    <a href="@SiteLinks.FooterLegal[i].Href">@SiteLinks.FooterLegal[i].Label</a>
                }
            </nav>
        </div>
    </div>
    <p class="site-footer__notice container">Đây là dự án học tập của sinh viên UEH (môn @Brand.Course), không phải cửa hàng thật. Đơn hàng sẽ không được giao, số liệu và đánh giá chỉ mang tính minh họa.</p>
</footer>
