@inject Peekbox.Web.Services.ShopInfo shop
<footer class="site-footer">
    <div class="site-footer__main container">
        <div class="site-footer__brand">
            <strong class="site-footer__name">Peekbox</strong>
            <p class="site-footer__tagline">Hộp quà theo ngân sách cho các dịp lễ trong năm.</p>
        </div>
        <nav class="site-footer__links" aria-labelledby="footer-explore">
            <h2 class="site-footer__title" id="footer-explore">Khám phá</h2>
            @foreach (var link in SiteLinks.FooterExplore)
            {
                <a href="@link.Href">@link.Label</a>
            }
        </nav>
        <nav class="site-footer__links" aria-labelledby="footer-dip">
            <h2 class="site-footer__title" id="footer-dip">Dịp</h2>
            @await Component.InvokeAsync("OccasionLinks", new { variant = "Footer" })
        </nav>
        <div class="site-footer__contact">
            <h2 class="site-footer__title">Liên hệ</h2>
            <p><a href="@shop.PhoneLink">@shop.Phone</a><br><a href="@shop.EmailLink">@shop.Email</a><br>@shop.Address</p>
        </div>
    </div>
    <div class="site-footer__bottom">
        <div class="site-footer__bottom-inner container">
            <p class="site-footer__copy">© Peekbox</p>
            <nav class="site-footer__legal" aria-label="Pháp lý">
                @for (var i = 0; i < SiteLinks.FooterLegal.Count; i++)
                {
                    if (i > 0)
                    {
                        <span aria-hidden="true">·</span>
                    }
                    <a href="@SiteLinks.FooterLegal[i].Href">@SiteLinks.FooterLegal[i].Label</a>
                }
            </nav>
        </div>
    </div>
</footer>
