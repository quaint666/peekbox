@using Peekbox.Web.Formatting
@using Peekbox.Web.Services
@model Box
@* F35 (mockup 30): items that expire before the delivery date block the order until they go or the date changes. Drawn
   by the review page and the cart, only when Box.OutOfDate is not empty. *@
@{
    var outOfDate = Model.OutOfDate;
}
<section class="review-block" aria-labelledby="block-title">
    <partial name="_Icon" model='"warning"' />
    <div>
        <h2 class="review-block__title" id="block-title">Chưa thể đặt hàng: @outOfDate.Count món hết hạn trước ngày giao</h2>
        <p class="review-block__text">@string.Join(", ", outOfDate.Select(l => $"{l.Name} hết hạn ngày {VnDate.Day(l.ExpiryDate)}")), còn ngày giao của bạn là @VnDate.Day(Model.DeliveryDate!.Value). Mỗi món cần còn hạn thêm @BuilderLimits.ShelfMarginDays ngày dự phòng sau ngày giao. Hãy bỏ @(outOfDate.Count == 1 ? "món này" : "các món này") hoặc đổi ngày giao để tiếp tục.</p>
    </div>
</section>
