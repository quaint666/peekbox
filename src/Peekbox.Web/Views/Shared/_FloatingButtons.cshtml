@inject Peekbox.Web.Services.ShopInfo shop

@* F06 and F07: two round buttons at the bottom right of every page. "Liên hệ" opens a small panel (a popover, no script) with
   Zalo, the phone, the email and the support hours; "Lên đầu trang" shows after the page has been scrolled (layout.ts). On a
   phone a bar that stays at the bottom of the screen carries data-bottom-bar, and layout.ts lifts the buttons above it. *@
<div class="float-stack">
    <button type="button" class="float-btn float-top" data-action="to-top" aria-label="Lên đầu trang" hidden><partial name="_Icon" model='"chevron-up"' /></button>
    <button type="button" class="float-btn float-contact" popovertarget="lien-he" aria-label="Liên hệ"><partial name="_Icon" model='"chat"' /></button>
    <div class="contact-panel" id="lien-he" popover role="dialog" aria-labelledby="lien-he-title">
        <h2 class="contact-panel__title" id="lien-he-title">Cần hỗ trợ?</h2>
        <a class="contact-panel__link" href="@shop.ZaloUrl" target="_blank" rel="noopener"><strong>Chat qua Zalo<span class="visually-hidden"> (mở trang mới)</span></strong><span>@shop.ZaloLabel</span></a>
        <a class="contact-panel__link" href="@shop.PhoneLink"><strong>Gọi điện</strong><span>@shop.Phone</span></a>
        <a class="contact-panel__link" href="@shop.EmailLink"><strong>Gửi email</strong><span>@shop.Email</span></a>
        <p class="contact-panel__hours">Hỗ trợ @shop.SupportHours</p>
    </div>
</div>
