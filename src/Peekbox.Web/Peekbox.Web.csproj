<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ef905cbf-d062-4a03-9299-f83a648eb140</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample catalogue stays in content/data/ (one copy); it is copied next to the app to seed the database. -->
    <None Include="..\..\content\data\products.json" Link="Seed\products.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\data\packaging.json" Link="Seed\packaging.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\data\wards.json" Link="Seed\wards.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\data\hampers.json" Link="Seed\hampers.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The home page text stays in content/data/ (one copy); it is copied next to the app and read at start. -->
    <None Include="..\..\content\data\home.json" Link="Content\home.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The About page copy and the legal texts stay in content/ (one copy); they are copied next to the app and read at start. -->
    <None Include="..\..\content\pages\about-and-commitments.md" Link="Content\about.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\content\legal\*.vi.md" Link="Content\legal\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
