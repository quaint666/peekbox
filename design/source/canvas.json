  "notes": {
    "n1": {
      "fill": "orange",
      "size": 24,
      "text": "Chosen: palette A (sage and cream) with Be Vietnam Pro. Sample prices and brand names are placeholders.",
      "w": 360,
      "x": 1520,
      "y": 0
    },
    "n12": {
      "fill": "orange",
      "size": 24,
      "text": "Legal text is a placeholder: it must be written and checked before real use. Blog titles are sample ideas, not written posts.",
      "w": 360,
      "x": 1960,
      "y": 27220
    },
    "n13": {
      "fill": "orange",
      "size": 24,
      "text": "Admin: desktop on the left, mobile on the right. On mobile, tables become cards and the menu becomes a scrolling row of tabs. Item expiry is shown beside stock; an expired item is flagged in red.",
      "w": 360,
      "x": 1960,
      "y": 30300
    },
    "n14": {
      "fill": "orange",
      "size": 24,
      "text": "New: a VI/EN switch and a light/dark button in every header. Dark and English are drawn for three pages; the rest follow the same tokens and dictionaries.",
      "w": 360,
      "x": 3040,
      "y": 43540
    },
    "n15": {
      "fill": "orange",
      "size": 24,
      "text": "New: campaigns. Each occasion has dates, a banner in VI and EN, a last delivery date and starter boxes.",
      "w": 360,
      "x": 1960,
      "y": 41760
    },
    "n3": {
      "fill": "orange",
      "size": 24,
      "text": "Decided: an item that expires before delivery date + margin blocks checkout. The customer removes it or changes the delivery date.",
      "w": 360,
      "x": 1960,
      "y": 3760
    },
    "n5": {
      "fill": "orange",
      "size": 24,
      "text": "Delivery only for now (Bloomy also had pickup). Payment: ZaloPay or cash on delivery. Shipping fee is not part of the budget.",
      "w": 360,
      "x": 1960,
      "y": 8180
    },
    "n6": {
      "fill": "orange",
      "size": 24,
      "text": "Status strip and tracking come from the existing order page; no new feature. Every item is listed with brand, weight, origin and expiry.",
      "w": 360,
      "x": 1960,
      "y": 11160
    },
    "n8": {
      "fill": "orange",
      "size": 24,
      "text": "Descriptions, dates and reviews are placeholders in [BRACKETS]. No invented reviews.",
      "w": 360,
      "x": 1960,
      "y": 16360
    },
    "t1": {
