    "t30": {
      "kind": "title1",
      "maxW": 1910,
      "text": "Quality-of-life additions: search, toast, share, floating buttons, loading, resume",
      "w": 240,
      "x": 0,
      "y": 129570
    },
    "n30": {
      "fill": "orange",
      "size": 24,
      "w": 360,
      "x": 1960,
      "y": 129810,
      "text": "New after comparing Bloomy and live shops. Search must ignore accents: typing \"mut\" should find \"Mứt\". The \"only items in date\" filter is on by default and the page says how many items it hides. Contact numbers, hours and the Zalo account are placeholders."
    },
